{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceMapper Lite",
  "version": "0.1.0",
  "identifier": "tech.padek-interactive.spacemapper.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpaceMapper Lite",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Padek-interactive",
    "copyright": "© 2026 Padek-interactive",
    "shortDescription": "Configuration des contrôles Star Citizen",
    "longDescription": "SpaceMapper Lite détecte vos périphériques de vol, affiche vos assignations Star Citizen de façon lisible et permet de réassigner les commandes de pilotage et de déplacement à pied. Édition gratuite, entièrement hors ligne : aucun accès réseau, aucune télémétrie.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
