# ---- Secrets : ne JAMAIS committer ----
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
**/private_key*
**/signing_key*

# ---- Rust ----
/target/
**/target/
Cargo.lock.bak

# ---- Node ----
node_modules/
dist/
dist-ssr/
.vite/
*.local

# packages/ui et packages/app-core sont consommes par le depot prive Premium
# via submodule git,
# sans workspace npm partage entre les deux depots : dist/ (JS + .d.ts
# pre-compiles) doit donc etre commite plutot qu'ignore, sans quoi Premium
# devrait reconstruire un workspace npm qui n'est pas le sien.
!/packages/ui/dist/
!/packages/app-core/dist/

# ---- Tauri ----
/apps/*/src-tauri/target/
/apps/*/src-tauri/gen/

# ---- Editeurs / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs / temp ----
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
